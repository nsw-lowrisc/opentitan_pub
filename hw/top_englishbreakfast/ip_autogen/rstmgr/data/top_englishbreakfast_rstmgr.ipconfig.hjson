{
  instance_name: top_englishbreakfast_rstmgr
  param_values:
  {
    clk_freqs:
    {
      aon: 200000
      io_div4: 24000000
      main: 100000000
      io: 96000000
      usb: 48000000
    }
    reqs:
    {
      int:
      [
        {
          name: MainPwr
          desc: main power glitch reset request
          module: pwrmgr
        }
        {
          name: Esc
          desc: escalation reset request
          module: alert_handler
        }
      ]
      debug:
      [
        {
          name: Ndm
          desc: non-debug-module reset request
          module: rv_dm
        }
      ]
      peripheral:
      [
        {
          name: aon_timer_rst_req
          width: "1"
          module: aon_timer
          desc: Watchdog reset request.
          enabled_after_reset: false
        }
      ]
    }
    power_domains:
    [
      Aon
      Main
    ]
    num_rstreqs: 1
    sw_rsts:
    {
      spi_device: io_div4
      spi_host0: io
      usb: usb
    }
